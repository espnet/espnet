{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "should_stop": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "evidence supporting the decision"
    },
    "key_metrics": {
      "type": "array",
      "description": "metrics behind the decision, one {key: name, value} each",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "key",
          "value"
        ]
      }
    }
  },
  "required": [
    "should_stop",
    "reason",
    "key_metrics"
  ]
}
