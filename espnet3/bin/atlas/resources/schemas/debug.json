{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root_cause": {
      "type": "string"
    },
    "fix_strategy": {
      "type": "string"
    },
    "files_modified": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "list of src/ files edited (empty if none)"
    },
    "config_patches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "training": {
          "type": "array",
          "description": "one {key: dotted.key, value} per change (or empty list)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "key",
              "value"
            ]
          }
        },
        "inference": {
          "type": "array",
          "description": "one {key: dotted.key, value} per change (or empty list)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "key",
              "value"
            ]
          }
        }
      },
      "required": [
        "training",
        "inference"
      ]
    },
    "should_retry": {
      "type": "boolean"
    }
  },
  "required": [
    "root_cause",
    "fix_strategy",
    "files_modified",
    "config_patches",
    "should_retry"
  ]
}
